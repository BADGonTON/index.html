# ══════════════════════════════════════════════════════════════════════════
#  HozirOL platformasi — muhit sozlamalari
#
#  Ishlatish:   cp .env.example .env    va quyidagilarni to'ldiring.
#  DIQQAT: .env fayli HECH QACHON git'ga qo'shilmaydi (.gitignore da).
# ══════════════════════════════════════════════════════════════════════════

# ─────────────────────────── Telegram ───────────────────────────

# @BotFather dan olingan token
BOT_TOKEN=

# Vergul bilan ajratilgan admin Telegram ID'lari (masalan: 1905881970,123456789)
ADMIN_IDS=

# Support havolasi
SUPPORT_BOT=https://t.me/HozirOIbot

# ── OMMAVIY OFERTA ──
#
# Bot BIRINCHI ishlatilganda foydalanuvchidan shu hujjatga rozilik so'raydi
# va rozilik bermaguncha hech qanday bo'limni ochmaydi.
#
# Nega kerak: bot Telegram Stars va Telegram akkauntlari savdosi bilan
# shug'ullanadi. Bunday xizmatlarda foydalanuvchining roziligi bo'lmasa,
# Telegram botni cheklab qo'yishi mumkin.
#
# Havola sayt sahifasi, Telegraph maqolasi yoki kanal posti bo'lishi mumkin.
OFFER_URL=

# ── TEXNIK ISHLAR ──
#
# Bu sozlama .env da EMAS — admin panelidan tugma bilan yoqiladi
# ("⛔ Texnik ishlarni yoqish"). Yoqilganda oddiy foydalanuvchi faqat
# "texnik ishlar bormoqda" javobini oladi va support havolasini ko'radi;
# adminlar uchun bot odatdagidek ishlaydi.
#
# Holat bazada saqlanadi, ya'ni botni qayta ishga tushirsangiz ham
# saqlanib qoladi.

# ── PREMIUM EMOJI ──
#
# Bot matnlaridagi HAMMA emoji premium (animatsion) emojiga aylanadi.
#
# DIQQAT: custom emoji yubora olish uchun bot Fragment'da qo'shimcha
# username sotib olgan bo'lishi kerak — bu Telegram cheklovi. Bot bunday
# bo'lmasa Telegram xabarlarni RAD ETADI; shunda bu yerga `false` yozing,
# matnlar oddiy emoji bilan chiqadi va bot ishlayveradi.
PREMIUM_EMOJI=true

# Kanal ID'lari (ixtiyoriy — bo'sh qoldirilsa o'sha log yuborilmaydi)
LOG_CHANNEL_ID=
PAYMENT_CHANNEL_ID=
ADMIN_CHANNEL_ID=

# ─────────────────────────── Server / Mini App ───────────────────────────

# Sizning domeningiz. https:// MAJBURIY — Telegram Mini App boshqacha ochilmaydi.
# Mini App shu manzilda bo'ladi:  https://sizning-domen.uz/app
PUBLIC_URL=https://sizning-domen.uz

PORT=8080

# nginx/Caddy orqasida ishlaganda true qoldiring
TRUST_PROXY=true

# Har bir kiruvchi HTTP so'rovni jurnalga yozish:
#   → GET  /app                200   8ms  ip=213.230.x.x
#   → GET  /api/bootstrap      200  41ms  ip=213.230.x.x user=1905881970
#   → POST /tg/***             200   6ms  ip=91.108.x.x    (Telegram webhook)
# "Serverga so'rov kelyaptimi?" degan savolga javob shu yerdan olinadi.
LOG_REQUESTS=true

# "webhook"  — ishlab chiqarish uchun (domen kerak, ko'p instance mumkin)
# "polling"  — lokal ishlab chiqish uchun (domen kerak emas)
BOT_MODE=webhook

# Webhook yo'lidagi maxfiy qism. Kamida 16 belgi. Yaratish:
#   openssl rand -hex 32
WEBHOOK_SECRET=

# ─────────────────────────── PostgreSQL ───────────────────────────

DATABASE_URL=postgresql://hozirol:PAROL@localhost:5432/hozirol
PGSSL=false

# Bitta process uchun ulanishlar soni.
# Bir nechta instance ishlatsangiz: (instance soni × PG_POOL_MAX) <= max_connections
PG_POOL_MAX=20
PG_STATEMENT_TIMEOUT_MS=15000

# ─────────────────────────── MarketApp (Fragment) ───────────────────────────

MARKETAPP_API_TOKEN=
MARKETAPP_API_BASE=https://api.marketapp.org

# ─────────────────────────── TON hamyon ───────────────────────────
#
# ⚠️  ENG MUHIM MAXFIY MA'LUMOT. Bu 24 so'z — hamyoningizdagi butun pul.
#     Uni hech kimga yubormang, screenshot qilmang, git'ga qo'ymang.
#
TON_MNEMONIC=""

# toncenter.com dan olinadi — bo'sh qoldirsangiz ham ishlaydi, lekin
# so'rovlar cheklovi (rate limit) qattiqroq bo'ladi.
TONCENTER_API_KEY=
TONCENTER_BASE_URL=https://toncenter.com/api/v2

# ─────────────────────────── Telegram profil sotish ───────────────────────────
# my.telegram.org/apps dan olinadi. Faqat "📱 Telegram profil" bo'limi uchun.
TG_API_ID=
TG_API_HASH=

# ─────────────────────────── To'lov (karta) ───────────────────────────

CARD_OWNER=
CARD_NUMBER=

# "To'lov aniqlandi" xabari bilan yuboriladigan NAMUNA RASM — chek qanday
# ko'rinishda bo'lishi kerakligini ko'rsatadi.
#
# Telegram file_id yoki https:// havola. Rasm bo'lmasa faqat matn ketadi.
# file_id ni olish: rasmni botga yuboring va loglardan nusxalang.
PAYMENT_RECEIPT_SAMPLE_PHOTO=

# To'lov oynasi (soniya) — shu vaqt ichida chek kelmasa, to'lov bekor qilinadi
PAYMENT_WINDOW_SEC=900
# Muddat o'tganda foydalanuvchi shuncha soniyaga bloklanadi
BAN_TIME_SEC=3600
MIN_PAYMENT=10000
# Referal foizi. 0.005 = 0.5%,  0.05 = 5%
#
# DIQQAT: bu har bir TO'LOVDAN olinadi, foydadan emas. 5% qo'ysangiz,
# 1 mln so'mlik to'lovda 50 ming so'm referalga ketadi. Marjangiz shundan
# yuqori ekaniga ishonch hosil qiling.
REF_PERCENT=0.005

# ─────────────────────────── Stars / Premium ───────────────────────────

STAR_MIN=50
STAR_MAX=5000

# Blokcheyn tranzaksiyalari orasidagi tanaffus (soniya)
TX_DELAY_SEC=10
MAX_RETRIES=3
ITEMS_PER_PAGE=10

# ─────────────────────────── Gift Arenda ───────────────────────────
#
# UZAYTIRISH sozlamalari .env da EMAS — admin panelidan o'zgartiriladi:
#
#   📆 Uzaytirish: eng kam kun     (standart 7 kun)
#   🧾 Uzaytirish: xizmat haqi     (standart 1 000 so'm)
#
# Nega kerak: har bir uzaytirish blokcheynga ALOHIDA tranzaksiya yuboradi
# va uning komissiyasi muddatga bog'liq emas — 1 kunga uzaytirishda ham,
# 30 kunga uzaytirishda ham bir xil to'lanadi. Eng kam muddat past bo'lsa,
# har bir qisqa uzaytirish zarar keltiradi.


# Butun katalog shu davrda bir marta TO'LIQ qayta o'qiladi (soniya).
#
# `/v1/rent/gifts/` hamma giftni kolleksiya filtrisiz, ~100 tadan sahifalab
# beradi — ~8 000 gift = ~80 ketma-ket so'rov. 240 soniya deganda katalog
# to'rt daqiqada bir yangilanadi: band qilingan gift ro'yxatda uzoq turmaydi,
# Marketapp'ga esa yuk deyarli bilinmaydi.
#
# Kamaytirsangiz ro'yxat yangiroq, lekin so'rovlar zichroq bo'ladi.
MARKET_SWEEP_SEC=240

# Marketapp'ga ikkita so'rov orasidagi eng kam tanaffus (ms).
# 429 kelsa bu qiymat avtomatik oshadi, keyin o'zi qaytadi —
# ya'ni tizim Marketapp'ning haqiqiy chegarasini o'zi topib oladi.
MARKET_MIN_INTERVAL_MS=1200

# Kolleksiyalar RO'YXATI shu davrda bir marta qayta o'qiladi (soniya)
MARKET_COLLECTIONS_REFRESH_SEC=900

# Kolleksiya ma'lumoti shu muddatdan eski bo'lsa "eskirgan" hisoblanadi
MARKET_STALE_SEC=3600

# Mini App bitta so'rovda nechta gift oladi
MARKET_PAGE_SIZE=60

# Profilga ulash bo'yicha QISQA video — ilova ichida o'ynatiladi.
#
# Video O'Z SERVERIMIZDA turadi: faylni shu yerga tashlang —
#
#     miniapp/media/guide.mp4
#
# Server uni `/app/media/guide.mp4` da beradi. Boshqa hech narsa
# sozlash shart emas. Batafsil: miniapp/media/README.md
PROFILE_LINK_VIDEO_FILE=guide.mp4

# Fayl o'rniga tashqi havola ishlatmoqchi bo'lsangiz (ixtiyoriy).
# Faqat to'g'ridan-to'g'ri .mp4 / .webm havolasi ishlaydi — YouTube
# havolasi Mini App ichida O'YNAMAYDI (uni pastdagi maydonga qo'ying).
PROFILE_LINK_VIDEO_URL=

# "Batafsil" tugmasi — to'liq YouTube qo'llanmasi (ixtiyoriy)
PROFILE_LINK_YOUTUBE_URL=

# ── To'plamlar (3 / 6 / 9 / 12 ta bir mavzudagi gift) ──
#
# Bu bo'lim sozlama TALAB QILMAYDI: to'plamlar katalogdagi giftlarning
# atributlaridan (Backdrop / Model / Symbol) XOTIRADA yig'iladi, ya'ni
# Marketapp'ga bitta ham qo'shimcha so'rov yubormaydi.
#
# Uchta daraja bor, hammasi ORQA FONDAN boshlanadi:
#   1) fon                  2) fon + model                3) fon + model + belgi
#
#   • eng kam muddat  — 7 kun
#   • xizmat haqi     — HAR BIR gift uchun SERVICE_FEE_SOM (admin panelidan)
#   • to'plam ustamasi — 10%   (masalan 100 000 → 110 000 so'm)
#
# Xizmat haqi botdagi "⚙️ Sozlamalar" bo'limidan o'zgartiriladi.

# ─────────────────────────── Mini App API himoyasi ───────────────────────────

# initData shu muddatdan eski bo'lsa qabul qilinmaydi (soniya)
INITDATA_MAX_AGE_SEC=21600

# Bitta foydalanuvchi daqiqasiga nechta API so'rov yubora oladi
API_RATE_LIMIT_PER_MIN=240
